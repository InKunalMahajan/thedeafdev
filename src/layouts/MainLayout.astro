---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "The Deaf Dev",
  description = "Deaf-friendly coding tutorials for beginners.",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body class="bg-white text-gray-900 antialiased dark:bg-gray-950 dark:text-white">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
