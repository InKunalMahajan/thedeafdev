---
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";

const { frontmatter } = Astro.props;
---

<html lang="en">
  <head>
    <title>{frontmatter.title}</title>
  </head>

  <body class="bg-white dark:bg-gray-950">
    <Header />

    <div class="mx-auto flex max-w-7xl">
      
      <!-- Sidebar -->
      <aside class="hidden w-72 border-r border-gray-200 p-6 dark:border-gray-800 lg:block">
        
        <h2 class="mb-6 text-lg font-bold text-gray-900 dark:text-white">
          HTML Tutorial
        </h2>

        <nav class="space-y-3">
          <a href="/tutorials/html/introduction" class="block text-gray-700 dark:text-gray-300">
            HTML Introduction
          </a>

          <a href="/tutorials/html/headings" class="block text-gray-700 dark:text-gray-300">
            HTML Headings
          </a>

          <a href="/tutorials/html/paragraphs" class="block text-gray-700 dark:text-gray-300">
            HTML Paragraphs
          </a>
        </nav>
      </aside>

      <!-- Content -->
      <main class="min-h-screen flex-1 px-6 py-12">
        <article class="prose prose-lg max-w-none dark:prose-invert">
          <slot />
        </article>
      </main>
    </div>

    <Footer />
  </body>
</html>