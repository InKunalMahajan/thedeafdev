---
const navItems = [
  { name: 'Home', href: '/' },
  { name: 'Tutorials', href: '/tutorials' },
  { name: 'Courses', href: '/courses' },
  { name: 'Resources', href: '/resources' },
  { name: 'Blogs', href: '/blogs' },
  { name: 'About', href: '/about' },
  { name: 'Contact', href: '/contact' },
];
---

<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/90 backdrop-blur-xl">
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-5 lg:px-8">
    <a href="/" class="flex items-center gap-3">
      <span class="grid h-11 w-14 place-items-center rounded-2xl bg-slate-950 text-sm font-black tracking-tight text-white shadow-sm">TDD</span>
      <span class="text-xl font-black tracking-tight text-slate-950">The Deaf Dev</span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex">
      {navItems.map((item) => (
        <a href={item.href} class="rounded-xl px-4 py-2 text-sm font-semibold text-slate-600 transition hover:bg-slate-100 hover:text-slate-950">
          {item.name}
        </a>
      ))}
    </nav>

    <a href="/start-learning" class="hidden rounded-2xl bg-slate-950 px-5 py-3 text-sm font-bold text-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-md md:inline-flex">
      Start Learning
    </a>
  </div>
</header>
