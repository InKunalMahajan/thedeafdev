---

---

<footer class="border-t border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950">
  <div class="mx-auto max-w-7xl px-4 py-14 lg:px-8">
    
    <!-- Top Section -->
    <div class="grid gap-10 md:grid-cols-4">
      
      <!-- Brand -->
      <div>
        <a
          href="/"
          class="flex items-center gap-2 text-xl font-bold text-gray-900 dark:text-white"
        >
          <span class="rounded-xl bg-black px-3 py-1 text-white dark:bg-white dark:text-black">
            TDD
          </span>

          <span>The Deaf Dev</span>
        </a>

        <p class="mt-4 text-sm leading-6 text-gray-600 dark:text-gray-400">
          Empowering the Deaf community through coding, technology,
          accessibility, and education.
        </p>
      </div>

      <!-- Tutorials -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-gray-900 dark:text-white">
          Tutorials
        </h3>

        <ul class="space-y-3 text-sm">
          <li>
            <a
              href="/tutorials/html"
              class="text-gray-600 transition hover:text-black dark:text-gray-400 dark:hover:text-white"
            >
              HTML
            </a>
          </li>

          <li>
            <a
              href="/tutorials/css"
              class="text-gray-600 transition hover:text-black dark:text-gray-400 dark:hover:text-white"
            >
              CSS
            </a>
          </li>

          <li>
            <a
              href="/tutorials/javascript"
              class="text-gray-600 transition hover:text-black dark:text-gray-400 dark:hover:text-white"
            >
              JavaScript
            </a>
          </li>

          <li>
            <a
              href="/tutorials/react"
              class="text-gray-600 transition hover:text-black dark:text-gray-400 dark:hover:text-white"
            >
              React
            </a>
          </li>
        </ul>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-gray-900 dark:text-white">
          Quick Links
        </h3>

        <ul class="space-y-3 text-sm">
          <li>
            <a
              href="/courses"
              class="text-gray-600 transition hover:text-black dark:text-gray-400 dark:hover:text-white"
            >
              Courses
            </a>
          </li>

          <li>
            <a
              href="/resources"
              class="text-gray-600 transition hover:text-black dark:text-gray-400 dark:hover:text-white"
            >
              Resources
            </a>
          </li>

          <li>
            <a
              href="/about"
              class="text-gray-600 transition hover:text-black dark:text-gray-400 dark:hover:text-white"
            >
              About
            </a>
          </li>

          <li>
            <a
              href="/contact"
              class="text-gray-600 transition hover:text-black dark:text-gray-400 dark:hover:text-white"
            >
              Contact
            </a>
          </li>
        </ul>
      </div>

      <!-- Newsletter -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-gray-900 dark:text-white">
          Join Community
        </h3>

        <p class="mb-4 text-sm text-gray-600 dark:text-gray-400">
          Get updates about new tutorials, resources, and courses.
        </p>

        <form class="flex flex-col gap-3">
          <input
            type="email"
            placeholder="Enter your email"
            class="rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-black dark:border-gray-700 dark:bg-gray-900 dark:text-white dark:focus:border-white"
          />

          <button
            type="submit"
            class="rounded-xl bg-black px-4 py-3 text-sm font-semibold text-white transition hover:opacity-90 dark:bg-white dark:text-black"
          >
            Subscribe
          </button>
        </form>
      </div>
    </div>

    <!-- Bottom -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-gray-200 pt-6 text-sm text-gray-500 dark:border-gray-800 dark:text-gray-400 md:flex-row">
      
      <p>
        © 2026 The Deaf Dev. All rights reserved.
      </p>

      <div class="flex items-center gap-5">
        <a
          href="#"
          class="transition hover:text-black dark:hover:text-white"
        >
          Privacy Policy
        </a>

        <a
          href="#"
          class="transition hover:text-black dark:hover:text-white"
        >
          Terms
        </a>

        <a
          href="#"
          class="transition hover:text-black dark:hover:text-white"
        >
          GitHub
        </a>
      </div>
    </div>
  </div>
</footer>