---
import MainLayout from "../layouts/MainLayout.astro"
---

<MainLayout
  title="The Deaf Dev"
  description="Accessible coding education platform for the Deaf community."
>
  <!-- Hero Section -->
  <section class="border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-950">
    <div class="mx-auto max-w-7xl px-4 py-24 lg:px-8">
      
      <div class="grid items-center gap-16 lg:grid-cols-2">
        
        <!-- Left Content -->
        <div>
          <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-gray-500">
            Accessible Technology Education
          </p>

          <h1 class="text-5xl font-bold tracking-tight text-gray-900 dark:text-white md:text-7xl">
            Learn Coding Without Barriers
          </h1>

          <p class="mt-8 max-w-2xl text-lg leading-8 text-gray-600 dark:text-gray-400">
            The Deaf Dev helps learners explore web development,
            programming, AI, and accessibility through visual-first
            and beginner-friendly education.
          </p>

          <!-- Buttons -->
          <div class="mt-10 flex flex-col gap-4 sm:flex-row">
            
            <a
              href="/tutorials"
              class="rounded-2xl bg-black px-7 py-4 text-center text-sm font-semibold text-white transition hover:opacity-90 dark:bg-white dark:text-black"
            >
              Start Learning
            </a>

            <a
              href="/about"
              class="rounded-2xl border border-gray-300 px-7 py-4 text-center text-sm font-semibold transition hover:border-black hover:text-black dark:border-gray-700 dark:hover:border-white dark:hover:text-white"
            >
              About Us
            </a>
          </div>

          <!-- Stats -->
          <div class="mt-14 grid grid-cols-3 gap-6">
            
            <div>
              <h3 class="text-3xl font-bold text-gray-900 dark:text-white">
                100+
              </h3>

              <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
                Tutorials
              </p>
            </div>

            <div>
              <h3 class="text-3xl font-bold text-gray-900 dark:text-white">
                AI
              </h3>

              <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
                Accessibility
              </p>
            </div>

            <div>
              <h3 class="text-3xl font-bold text-gray-900 dark:text-white">
                Open
              </h3>

              <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
                Community
              </p>
            </div>
          </div>
        </div>

        <!-- Right Card -->
        <div class="relative">
          
          <div class="rounded-4xl border border-gray-200 bg-gray-50 p-8 shadow-xl dark:border-gray-800 dark:bg-gray-900">
            
            <!-- Fake Code Window -->
            <div class="rounded-2xl bg-gray-950 p-6 text-sm text-gray-200">
              
              <div class="mb-5 flex gap-2">
                <div class="h-3 w-3 rounded-full bg-red-500"></div>
                <div class="h-3 w-3 rounded-full bg-yellow-500"></div>
                <div class="h-3 w-3 rounded-full bg-green-500"></div>
              </div>

              <pre class="overflow-x-auto leading-8">
<code>
&lt;html&gt;
  &lt;h1&gt;
    Learn Coding
  &lt;/h1&gt;

  &lt;p&gt;
    Accessible learning
    for everyone.
  &lt;/p&gt;
&lt;/html&gt;
</code>
              </pre>
            </div>

            <!-- Small Cards -->
            <div class="mt-6 grid gap-4 sm:grid-cols-2">
              
              <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-gray-950">
                <h3 class="font-semibold text-gray-900 dark:text-white">
                  Beginner Friendly
                </h3>

                <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
                  Step-by-step tutorials with visual explanations.
                </p>
              </div>

              <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-gray-950">
                <h3 class="font-semibold text-gray-900 dark:text-white">
                  Modern Technology
                </h3>

                <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
                  Learn Astro, React, Tailwind CSS, AI, and more.
                </p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Featured Tutorials -->
  <section class="bg-gray-50 dark:bg-gray-900">
    <div class="mx-auto max-w-7xl px-4 py-24 lg:px-8">
      
      <div class="mb-14 text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-gray-500">
          Tutorials
        </p>

        <h2 class="text-4xl font-bold text-gray-900 dark:text-white">
          Featured Learning Paths
        </h2>
      </div>

      <div class="grid gap-8 md:grid-cols-2 xl:grid-cols-4">
        
        <!-- Card -->
        <a
          href="/tutorials/html"
          class="rounded-3xl border border-gray-200 bg-white p-8 shadow-sm transition hover:-translate-y-1 dark:border-gray-800 dark:bg-gray-950"
        >
          <div class="text-5xl">🌐</div>

          <h3 class="mt-6 text-2xl font-bold text-gray-900 dark:text-white">
            HTML
          </h3>

          <p class="mt-4 leading-7 text-gray-600 dark:text-gray-400">
            Learn the structure of websites using simple HTML tutorials.
          </p>
        </a>

        <!-- Card -->
        <a
          href="/tutorials/css"
          class="rounded-3xl border border-gray-200 bg-white p-8 shadow-sm transition hover:-translate-y-1 dark:border-gray-800 dark:bg-gray-950"
        >
          <div class="text-5xl">🎨</div>

          <h3 class="mt-6 text-2xl font-bold text-gray-900 dark:text-white">
            CSS
          </h3>

          <p class="mt-4 leading-7 text-gray-600 dark:text-gray-400">
            Design beautiful responsive websites with CSS and Tailwind CSS.
          </p>
        </a>

        <!-- Card -->
        <a
          href="/tutorials/javascript"
          class="rounded-3xl border border-gray-200 bg-white p-8 shadow-sm transition hover:-translate-y-1 dark:border-gray-800 dark:bg-gray-950"
        >
          <div class="text-5xl">⚡</div>

          <h3 class="mt-6 text-2xl font-bold text-gray-900 dark:text-white">
            JavaScript
          </h3>

          <p class="mt-4 leading-7 text-gray-600 dark:text-gray-400">
            Add interactivity and functionality to modern web applications.
          </p>
        </a>

        <!-- Card -->
        <a
          href="/tutorials/react"
          class="rounded-3xl border border-gray-200 bg-white p-8 shadow-sm transition hover:-translate-y-1 dark:border-gray-800 dark:bg-gray-950"
        >
          <div class="text-5xl">⚛️</div>

          <h3 class="mt-6 text-2xl font-bold text-gray-900 dark:text-white">
            React
          </h3>

          <p class="mt-4 leading-7 text-gray-600 dark:text-gray-400">
            Build modern UI applications using reusable React components.
          </p>
        </a>
      </div>
    </div>
  </section>

  <!-- Why Learn Here -->
  <section class="bg-white dark:bg-gray-950">
    <div class="mx-auto max-w-7xl px-4 py-24 lg:px-8">
      
      <div class="grid items-center gap-16 lg:grid-cols-2">
        
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-gray-500">
            Why The Deaf Dev
          </p>

          <h2 class="text-4xl font-bold text-gray-900 dark:text-white">
            Built for Accessible Learning
          </h2>

          <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-400">
            Our platform focuses on visual-first education with simple explanations,
            modern tools, and practical learning paths.
          </p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          
          <div class="rounded-3xl border border-gray-200 p-8 dark:border-gray-800">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
              Visual Learning
            </h3>

            <p class="mt-3 text-gray-600 dark:text-gray-400">
              Clear structure and easy-to-understand tutorials.
            </p>
          </div>

          <div class="rounded-3xl border border-gray-200 p-8 dark:border-gray-800">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
              Modern Stack
            </h3>

            <p class="mt-3 text-gray-600 dark:text-gray-400">
              Learn Astro, Tailwind CSS, React, GitHub, and AI tools.
            </p>
          </div>

          <div class="rounded-3xl border border-gray-200 p-8 dark:border-gray-800">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
              Community Driven
            </h3>

            <p class="mt-3 text-gray-600 dark:text-gray-400">
              Empowering Deaf learners through accessible education.
            </p>
          </div>

          <div class="rounded-3xl border border-gray-200 p-8 dark:border-gray-800">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
              Beginner Friendly
            </h3>

            <p class="mt-3 text-gray-600 dark:text-gray-400">
              Step-by-step tutorials designed for all learners.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-black text-white dark:bg-white dark:text-black">
    <div class="mx-auto max-w-5xl px-4 py-24 text-center lg:px-8">
      
      <h2 class="text-4xl font-bold">
        Start Building Your Future Today
      </h2>

      <p class="mx-auto mt-6 max-w-2xl text-lg opacity-80">
        Explore tutorials, projects, resources, and modern web development tools.
      </p>

      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        
        <a
          href="/tutorials"
          class="rounded-2xl bg-white px-7 py-4 font-semibold text-black transition hover:opacity-90 dark:bg-black dark:text-white"
        >
          Explore Tutorials
        </a>

        <a
          href="/resources"
          class="rounded-2xl border border-white px-7 py-4 font-semibold transition hover:bg-white hover:text-black dark:border-black dark:hover:bg-black dark:hover:text-white"
        >
          View Resources
        </a>
      </div>
    </div>
  </section>
</MainLayout>