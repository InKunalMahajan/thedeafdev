---
import Layout from "../layouts/MainLayout.astro";
---

<Layout
  title="Contact | The Deaf Dev"
  description="Contact The Deaf Dev for collaboration, accessibility, education, and technology inquiries."
>
  <!-- Hero Section -->
  <section class="border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-950">
    <div class="mx-auto max-w-5xl px-4 py-20 text-center lg:px-8">
      
      <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-gray-500">
        Contact Us
      </p>

      <h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white md:text-6xl">
        Let’s Connect
      </h1>

      <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-gray-600 dark:text-gray-400">
        Have questions, ideas, collaborations, or accessibility suggestions?
        We would love to hear from you.
      </p>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="bg-gray-50 dark:bg-gray-900">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 lg:grid-cols-2 lg:px-8">
      
      <!-- Left Content -->
      <div>
        <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-gray-500">
          Get In Touch
        </p>

        <h2 class="text-3xl font-bold text-gray-900 dark:text-white">
          We’re Here to Help
        </h2>

        <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-400">
          Whether you are a learner, educator, developer, organization,
          or supporter of accessibility and Deaf education, feel free to contact us.
        </p>

        <!-- Contact Cards -->
        <div class="mt-10 space-y-6">
          
          <div class="rounded-3xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-gray-950">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
              Email
            </h3>

            <p class="mt-2 text-gray-600 dark:text-gray-400">
              hello@thedeafdev.in
            </p>
          </div>

          <div class="rounded-3xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-gray-950">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
              Collaboration
            </h3>

            <p class="mt-2 text-gray-600 dark:text-gray-400">
              Partnerships, accessibility projects, workshops, and educational initiatives.
            </p>
          </div>

          <div class="rounded-3xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-gray-950">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
              Community
            </h3>

            <p class="mt-2 text-gray-600 dark:text-gray-400">
              Supporting inclusive learning and technology opportunities for the Deaf community.
            </p>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="rounded-3xl border border-gray-200 bg-white p-8 shadow-sm dark:border-gray-800 dark:bg-gray-950">
        
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
          Send a Message
        </h2>

        <p class="mt-3 text-gray-600 dark:text-gray-400">
          Fill out the form below and we’ll get back to you soon.
        </p>

        <form class="mt-8 space-y-6">
          
          <!-- Name -->
          <div>
            <label
              for="name"
              class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300"
            >
              Full Name
            </label>

            <input
              type="text"
              id="name"
              placeholder="Enter your name"
              class="w-full rounded-2xl border border-gray-300 bg-white px-4 py-3 outline-none transition focus:border-black dark:border-gray-700 dark:bg-gray-900 dark:text-white dark:focus:border-white"
            />
          </div>

          <!-- Email -->
          <div>
            <label
              for="email"
              class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300"
            >
              Email Address
            </label>

            <input
              type="email"
              id="email"
              placeholder="Enter your email"
              class="w-full rounded-2xl border border-gray-300 bg-white px-4 py-3 outline-none transition focus:border-black dark:border-gray-700 dark:bg-gray-900 dark:text-white dark:focus:border-white"
            />
          </div>

          <!-- Subject -->
          <div>
            <label
              for="subject"
              class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300"
            >
              Subject
            </label>

            <input
              type="text"
              id="subject"
              placeholder="Enter subject"
              class="w-full rounded-2xl border border-gray-300 bg-white px-4 py-3 outline-none transition focus:border-black dark:border-gray-700 dark:bg-gray-900 dark:text-white dark:focus:border-white"
            />
          </div>

          <!-- Message -->
          <div>
            <label
              for="message"
              class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300"
            >
              Message
            </label>

            <textarea
              id="message"
              rows="6"
              placeholder="Write your message..."
              class="w-full rounded-2xl border border-gray-300 bg-white px-4 py-3 outline-none transition focus:border-black dark:border-gray-700 dark:bg-gray-900 dark:text-white dark:focus:border-white"
            ></textarea>
          </div>

          <!-- Button -->
          <button
            type="submit"
            class="w-full rounded-2xl bg-black px-6 py-4 text-sm font-semibold text-white transition hover:opacity-90 dark:bg-white dark:text-black"
          >
            Send Message
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-black text-white dark:bg-white dark:text-black">
    <div class="mx-auto max-w-5xl px-4 py-20 text-center lg:px-8">
      
      <h2 class="text-4xl font-bold">
        Build an Inclusive Future Together
      </h2>

      <p class="mx-auto mt-6 max-w-2xl text-lg opacity-80">
        Technology becomes powerful when everyone has equal access to learning and opportunities.
      </p>

      <div class="mt-8">
        <a
          href="/tutorials"
          class="rounded-2xl bg-white px-6 py-3 font-semibold text-black transition hover:opacity-90 dark:bg-black dark:text-white"
        >
          Explore Tutorials
        </a>
      </div>
    </div>
  </section>
</Layout>