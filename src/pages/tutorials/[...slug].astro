---
import { getCollection, render } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import TutorialSidebar from '../../components/TutorialSidebar.astro';

export async function getStaticPaths() {
  const tutorials = await getCollection('tutorials');
  return tutorials.map((tutorial) => ({
    params: { slug: tutorial.id },
    props: { tutorial },
  }));
}

const { tutorial } = Astro.props;
const { Content } = await render(tutorial);
const tutorials = await getCollection('tutorials');
const sameCategory = tutorials
  .filter((item) => item.data.category === tutorial.data.category)
  .sort((a, b) => a.data.order - b.data.order);
const currentIndex = sameCategory.findIndex((item) => item.id === tutorial.id);
const previousLesson = sameCategory[currentIndex - 1];
const nextLesson = sameCategory[currentIndex + 1];
---

<MainLayout title={`${tutorial.data.title} | The Deaf Dev`} description={tutorial.data.description}>
  <div class="flex min-h-screen bg-slate-50">
    <TutorialSidebar tutorials={tutorials} currentId={tutorial.id} />

    <main class="min-w-0 flex-1">
      <section class="border-b border-slate-200 bg-white">
        <div class="mx-auto max-w-5xl px-5 py-10 lg:px-10">
          <a href={`/tutorials/${tutorial.data.category.toLowerCase()}`} class="inline-flex items-center rounded-full bg-slate-100 px-4 py-2 text-sm font-bold text-slate-700 transition hover:bg-yellow-100 hover:text-slate-950">
            ← {tutorial.data.category} lessons
          </a>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <span class="rounded-full bg-yellow-300 px-4 py-2 text-xs font-black uppercase tracking-[0.2em] text-slate-950">
              Lesson {tutorial.data.order}
            </span>
            <span class="rounded-full bg-slate-950 px-4 py-2 text-xs font-black uppercase tracking-[0.2em] text-white">
              {tutorial.data.category}
            </span>
          </div>

          <h1 class="mt-6 max-w-4xl text-4xl font-black tracking-tight text-slate-950 md:text-6xl">
            {tutorial.data.title}
          </h1>

          <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600 md:text-xl">
            {tutorial.data.description}
          </p>
        </div>
      </section>

      <section class="mx-auto grid max-w-12xl gap-10 px-5 py-10 lg:px-10 xl:grid-cols-[minmax(0,1fr)_220px]">
        <article class="rounded-8rem border-slate-200 bg-white p-6 shadow-sm md:p-10 ">
          <div class="tutorial-content">
            <Content />
          </div>

          <div class="mt-24 grid gap-4 border-t border-slate-200 pt-8 md:grid-cols-2">
            {previousLesson ? (
              <a href={`/tutorials/${previousLesson.id}`} class="rounded-3xl border border-slate-200 p-5 transition hover:-translate-y-1 hover:border-slate-950 hover:shadow-md">
                <p class="text-sm font-bold text-slate-500">← Previous</p>
                <h3 class="mt-2 font-black text-slate-950">{previousLesson.data.title}</h3>
              </a>
            ) : <div></div>}

            {nextLesson ? (
              <a href={`/tutorials/${nextLesson.id}`} class="rounded-3xl border border-slate-200 p-5 text-right transition hover:-translate-y-1 hover:border-slate-950 hover:shadow-md">
                <p class="text-sm font-bold text-slate-500">Next →</p>
                <h3 class="mt-2 font-black text-slate-950">{nextLesson.data.title}</h3>
              </a>
            ) : <div></div>}
          </div>
        </article>

        <aside class="hidden xl:block">
          <div class="sticky top-28 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-xs font-black uppercase tracking-[0.2em] text-slate-500">Quick Help</p>
            <div class="mt-4 space-y-3 text-sm font-semibold text-slate-600">
              <a class="block rounded-2xl bg-slate-100 px-4 py-3 hover:bg-yellow-100" href={`/tutorials/${tutorial.data.category.toLowerCase()}`}>All {tutorial.data.category} lessons</a>
              <a class="block rounded-2xl bg-slate-100 px-4 py-3 hover:bg-yellow-100" href="/tutorials">All tutorials</a>
            </div>
          </div>
        </aside>
      </section>
    </main>
  </div>
</MainLayout>
