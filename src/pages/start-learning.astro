---
import Layout from "../layouts/MainLayout.astro";
---

<Layout
  title="Start Learning | The Deaf Dev"
  description="Start your coding journey with accessible tutorials, courses, and modern web development learning paths."
>
  <!-- Hero -->
  <section class="border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-950">
    <div class="mx-auto max-w-5xl px-4 py-24 text-center lg:px-8">
      
      <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-gray-500">
        Start Learning
      </p>

      <h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white md:text-6xl">
        Begin Your Coding Journey Today
      </h1>

      <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-gray-600 dark:text-gray-400">
        Learn modern web development step-by-step through beginner-friendly,
        visual-first, and accessible education.
      </p>

      <!-- CTA -->
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        
        <a
          href="/tutorials"
          class="rounded-2xl bg-black px-7 py-4 text-sm font-semibold text-white transition hover:opacity-90 dark:bg-white dark:text-black"
        >
          Explore Tutorials
        </a>

        <a
          href="/courses"
          class="rounded-2xl border border-gray-300 px-7 py-4 text-sm font-semibold transition hover:border-black hover:text-black dark:border-gray-700 dark:hover:border-white dark:hover:text-white"
        >
          Browse Courses
        </a>
      </div>
    </div>
  </section>

  <!-- Learning Paths -->
  <section class="bg-gray-50 dark:bg-gray-900">
    <div class="mx-auto max-w-7xl px-4 py-20 lg:px-8">
      
      <div class="mb-14 text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-gray-500">
          Learning Paths
        </p>

        <h2 class="text-4xl font-bold text-gray-900 dark:text-white">
          Choose Your Path
        </h2>
      </div>

      <div class="grid gap-8 md:grid-cols-2 xl:grid-cols-4">
        
        <!-- Card -->
        <a
          href="/tutorials/html"
          class="rounded-3xl border border-gray-200 bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:shadow-lg dark:border-gray-800 dark:bg-gray-950"
        >
          <div class="text-5xl">🌐</div>

          <h3 class="mt-6 text-2xl font-bold text-gray-900 dark:text-white">
            HTML
          </h3>

          <p class="mt-4 leading-7 text-gray-600 dark:text-gray-400">
            Learn the foundation of every website using HTML structure and elements.
          </p>
        </a>

        <!-- Card -->
        <a
          href="/tutorials/css"
          class="rounded-3xl border border-gray-200 bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:shadow-lg dark:border-gray-800 dark:bg-gray-950"
        >
          <div class="text-5xl">🎨</div>

          <h3 class="mt-6 text-2xl font-bold text-gray-900 dark:text-white">
            CSS
          </h3>

          <p class="mt-4 leading-7 text-gray-600 dark:text-gray-400">
            Design beautiful responsive layouts using CSS and Tailwind CSS.
          </p>
        </a>

        <!-- Card -->
        <a
          href="/tutorials/javascript"
          class="rounded-3xl border border-gray-200 bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:shadow-lg dark:border-gray-800 dark:bg-gray-950"
        >
          <div class="text-5xl">⚡</div>

          <h3 class="mt-6 text-2xl font-bold text-gray-900 dark:text-white">
            JavaScript
          </h3>

          <p class="mt-4 leading-7 text-gray-600 dark:text-gray-400">
            Add interactivity and logic to websites and applications.
          </p>
        </a>

        <!-- Card -->
        <a
          href="/tutorials/react"
          class="rounded-3xl border border-gray-200 bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:shadow-lg dark:border-gray-800 dark:bg-gray-950"
        >
          <div class="text-5xl">⚛️</div>

          <h3 class="mt-6 text-2xl font-bold text-gray-900 dark:text-white">
            React
          </h3>

          <p class="mt-4 leading-7 text-gray-600 dark:text-gray-400">
            Build modern component-based user interfaces using React.
          </p>
        </a>
      </div>
    </div>
  </section>

  <!-- Steps -->
  <section class="bg-white dark:bg-gray-950">
    <div class="mx-auto max-w-7xl px-4 py-20 lg:px-8">
      
      <div class="mb-16 text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-gray-500">
          How It Works
        </p>

        <h2 class="text-4xl font-bold text-gray-900 dark:text-white">
          Learn Step-by-Step
        </h2>
      </div>

      <div class="grid gap-8 md:grid-cols-3">
        
        <!-- Step -->
        <div class="rounded-3xl border border-gray-200 p-8 dark:border-gray-800">
          
          <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-black text-xl font-bold text-white dark:bg-white dark:text-black">
            1
          </div>

          <h3 class="mt-6 text-2xl font-bold text-gray-900 dark:text-white">
            Choose a Topic
          </h3>

          <p class="mt-4 leading-7 text-gray-600 dark:text-gray-400">
            Start with beginner-friendly tutorials like HTML, CSS, or JavaScript.
          </p>
        </div>

        <!-- Step -->
        <div class="rounded-3xl border border-gray-200 p-8 dark:border-gray-800">
          
          <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-black text-xl font-bold text-white dark:bg-white dark:text-black">
            2
          </div>

          <h3 class="mt-6 text-2xl font-bold text-gray-900 dark:text-white">
            Practice Projects
          </h3>

          <p class="mt-4 leading-7 text-gray-600 dark:text-gray-400">
            Build practical projects while learning real-world coding skills.
          </p>
        </div>

        <!-- Step -->
        <div class="rounded-3xl border border-gray-200 p-8 dark:border-gray-800">
          
          <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-black text-xl font-bold text-white dark:bg-white dark:text-black">
            3
          </div>

          <h3 class="mt-6 text-2xl font-bold text-gray-900 dark:text-white">
            Build Your Future
          </h3>

          <p class="mt-4 leading-7 text-gray-600 dark:text-gray-400">
            Use your skills to create websites, applications, and accessible solutions.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="border-y border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-900">
    <div class="mx-auto max-w-7xl px-4 py-20 lg:px-8">
      
      <div class="grid gap-8 md:grid-cols-2 xl:grid-cols-4">
        
        <div class="rounded-3xl border border-gray-200 bg-white p-8 dark:border-gray-800 dark:bg-gray-950">
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
            Beginner Friendly
          </h3>

          <p class="mt-3 text-gray-600 dark:text-gray-400">
            Learn coding concepts with simple explanations and visual structure.
          </p>
        </div>

        <div class="rounded-3xl border border-gray-200 bg-white p-8 dark:border-gray-800 dark:bg-gray-950">
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
            Modern Technologies
          </h3>

          <p class="mt-3 text-gray-600 dark:text-gray-400">
            Learn Astro, React, Tailwind CSS, GitHub, and AI tools.
          </p>
        </div>

        <div class="rounded-3xl border border-gray-200 bg-white p-8 dark:border-gray-800 dark:bg-gray-950">
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
            Accessibility Focused
          </h3>

          <p class="mt-3 text-gray-600 dark:text-gray-400">
            Built to support inclusive and accessible technology education.
          </p>
        </div>

        <div class="rounded-3xl border border-gray-200 bg-white p-8 dark:border-gray-800 dark:bg-gray-950">
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
            Community Driven
          </h3>

          <p class="mt-3 text-gray-600 dark:text-gray-400">
            Empowering Deaf learners through technology and education.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-black text-white dark:bg-white dark:text-black">
    <div class="mx-auto max-w-5xl px-4 py-24 text-center lg:px-8">
      
      <h2 class="text-4xl font-bold">
        Ready to Start Learning?
      </h2>

      <p class="mx-auto mt-6 max-w-2xl text-lg opacity-80">
        Explore tutorials, courses, and resources designed for accessible learning.
      </p>

      <div class="mt-10">
        <a
          href="/tutorials"
          class="rounded-2xl bg-white px-7 py-4 font-semibold text-black transition hover:opacity-90 dark:bg-black dark:text-white"
        >
          Start Now
        </a>
      </div>
    </div>
  </section>
</Layout>