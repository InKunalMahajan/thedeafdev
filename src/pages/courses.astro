---
import Layout from "../layouts/MainLayout.astro";

const courses = [
  {
    title: "Frontend Web Development",
    description:
      "Learn HTML, CSS, JavaScript, Tailwind CSS, and responsive web design from beginner to advanced.",
    lessons: "50+ Lessons",
    duration: "8 Weeks",
    level: "Beginner",
    icon: "🌐",
    link: "/courses/frontend-web-development",
  },

  {
    title: "React Development",
    description:
      "Build modern UI applications using React components, hooks, routing, and project-based learning.",
    lessons: "40+ Lessons",
    duration: "6 Weeks",
    level: "Intermediate",
    icon: "⚛️",
    link: "/courses/react-development",
  },

  {
    title: "Astro & Tailwind CSS",
    description:
      "Create fast modern websites using Astro framework and Tailwind CSS utility-first styling.",
    lessons: "30+ Lessons",
    duration: "5 Weeks",
    level: "Beginner",
    icon: "🚀",
    link: "/courses/astro-tailwind",
  },

  {
    title: "Git & GitHub",
    description:
      "Understand repositories, commits, branching, collaboration workflows, and open-source development.",
    lessons: "20+ Lessons",
    duration: "3 Weeks",
    level: "Beginner",
    icon: "🐙",
    link: "/courses/github",
  },

  {
    title: "AI Tools for Developers",
    description:
      "Learn AI-powered tools, productivity workflows, accessibility solutions, and modern developer tools.",
    lessons: "25+ Lessons",
    duration: "4 Weeks",
    level: "Intermediate",
    icon: "🤖",
    link: "/courses/ai-tools",
  },

  {
    title: "Accessibility & Inclusive Design",
    description:
      "Learn accessibility principles, inclusive UI/UX design, and web standards for better user experiences.",
    lessons: "18+ Lessons",
    duration: "3 Weeks",
    level: "All Levels",
    icon: "♿",
    link: "/courses/accessibility",
  },
];
---

<Layout
  title="Courses | The Deaf Dev"
  description="Explore modern coding courses, accessible technology education, and developer learning paths."
>
  <!-- Hero -->
  <section class="border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-950">
    <div class="mx-auto max-w-5xl px-4 py-20 text-center lg:px-8">
      
      <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-gray-500">
        Courses
      </p>

      <h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white md:text-6xl">
        Learn Through Structured Courses
      </h1>

      <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-gray-600 dark:text-gray-400">
        Explore beginner-friendly and modern technology courses designed for
        accessible and visual-first learning experiences.
      </p>
    </div>
  </section>

  <!-- Courses Grid -->
  <section class="bg-gray-50 dark:bg-gray-900">
    <div class="mx-auto max-w-7xl px-4 py-20 lg:px-8">
      
      <div class="mb-14 flex flex-col items-center justify-between gap-6 md:flex-row">
        
        <div>
          <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-gray-500">
            Learning Programs
          </p>

          <h2 class="text-4xl font-bold text-gray-900 dark:text-white">
            Featured Courses
          </h2>
        </div>

        <!-- Search -->
        <div class="w-full md:w-80">
          <input
            type="text"
            placeholder="Search courses..."
            class="w-full rounded-2xl border border-gray-300 bg-white px-5 py-3 outline-none transition focus:border-black dark:border-gray-700 dark:bg-gray-950 dark:text-white dark:focus:border-white"
          />
        </div>
      </div>

      <!-- Course Cards -->
      <div class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">
        
        {courses.map((course) => (
          <a
            href={course.link}
            class="group rounded-3xl border border-gray-200 bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:shadow-lg dark:border-gray-800 dark:bg-gray-950"
          >
            <!-- Icon -->
            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-black text-3xl text-white dark:bg-white dark:text-black">
              {course.icon}
            </div>

            <!-- Title -->
            <h3 class="mt-6 text-2xl font-bold text-gray-900 dark:text-white">
              {course.title}
            </h3>

            <!-- Meta -->
            <div class="mt-4 flex flex-wrap gap-3">
              
              <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-700 dark:bg-gray-800 dark:text-gray-300">
                {course.lessons}
              </span>

              <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-700 dark:bg-gray-800 dark:text-gray-300">
                {course.duration}
              </span>

              <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-700 dark:bg-gray-800 dark:text-gray-300">
                {course.level}
              </span>
            </div>

            <!-- Description -->
            <p class="mt-6 leading-7 text-gray-600 dark:text-gray-400">
              {course.description}
            </p>

            <!-- Button -->
            <div class="mt-8 inline-flex items-center font-semibold text-black transition group-hover:translate-x-1 dark:text-white">
              View Course →
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Learning Benefits -->
  <section class="bg-white dark:bg-gray-950">
    <div class="mx-auto max-w-7xl px-4 py-20 lg:px-8">
      
      <div class="grid items-center gap-16 lg:grid-cols-2">
        
        <!-- Left -->
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-gray-500">
            Learning Experience
          </p>

          <h2 class="text-4xl font-bold text-gray-900 dark:text-white">
            Designed for Accessible Education
          </h2>

          <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-400">
            Courses are structured with visual-first learning, practical examples,
            and easy-to-understand explanations for modern learners.
          </p>
        </div>

        <!-- Right -->
        <div class="grid gap-6 sm:grid-cols-2">
          
          <div class="rounded-3xl border border-gray-200 p-8 dark:border-gray-800">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
              Step-by-Step Learning
            </h3>

            <p class="mt-3 text-gray-600 dark:text-gray-400">
              Learn gradually through structured lessons and projects.
            </p>
          </div>

          <div class="rounded-3xl border border-gray-200 p-8 dark:border-gray-800">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
              Real Projects
            </h3>

            <p class="mt-3 text-gray-600 dark:text-gray-400">
              Build practical websites and applications while learning.
            </p>
          </div>

          <div class="rounded-3xl border border-gray-200 p-8 dark:border-gray-800">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
              Modern Technologies
            </h3>

            <p class="mt-3 text-gray-600 dark:text-gray-400">
              Learn modern tools like Astro, React, GitHub, and AI workflows.
            </p>
          </div>

          <div class="rounded-3xl border border-gray-200 p-8 dark:border-gray-800">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
              Community Focused
            </h3>

            <p class="mt-3 text-gray-600 dark:text-gray-400">
              Empowering accessible education for Deaf learners and developers.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-black text-white dark:bg-white dark:text-black">
    <div class="mx-auto max-w-5xl px-4 py-20 text-center lg:px-8">
      
      <h2 class="text-4xl font-bold">
        Start Your Coding Journey
      </h2>

      <p class="mx-auto mt-6 max-w-2xl text-lg opacity-80">
        Explore structured learning paths and modern web development education.
      </p>

      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        
        <a
          href="/tutorials"
          class="rounded-2xl bg-white px-7 py-4 font-semibold text-black transition hover:opacity-90 dark:bg-black dark:text-white"
        >
          Explore Tutorials
        </a>

        <a
          href="/resources"
          class="rounded-2xl border border-white px-7 py-4 font-semibold transition hover:bg-white hover:text-black dark:border-black dark:hover:bg-black dark:hover:text-white"
        >
          View Resources
        </a>
      </div>
    </div>
  </section>
</Layout>