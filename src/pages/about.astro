---
import Layout from "../layouts/MainLayout.astro";
---

<Layout>
  <!-- Hero Section -->
  <section class="border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-950">
    <div class="mx-auto max-w-5xl px-4 py-20 text-center lg:px-8">
      
      <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-gray-500">
        About The Deaf Dev
      </p>

      <h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white md:text-6xl">
        Empowering the Deaf Community Through Technology
      </h1>

      <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-gray-600 dark:text-gray-400">
        The Deaf Dev is an educational platform created to make coding,
        technology, and digital learning more accessible for Deaf learners.
        We believe technology should be inclusive and understandable for everyone.
      </p>
    </div>
  </section>

  <!-- Mission Section -->
  <section class="bg-gray-50 dark:bg-gray-900">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 lg:grid-cols-2 lg:px-8">
      
      <div>
        <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-gray-500">
          Our Mission
        </p>

        <h2 class="text-3xl font-bold text-gray-900 dark:text-white">
          Learning Without Barriers
        </h2>

        <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-400">
          Our mission is to simplify technical education and create an inclusive
          learning environment where Deaf students can confidently learn coding,
          web development, AI, accessibility, and modern technology skills.
        </p>

        <p class="mt-4 text-lg leading-8 text-gray-600 dark:text-gray-400">
          We focus on visual learning, structured tutorials, practical examples,
          and community-driven education.
        </p>
      </div>

      <div class="rounded-3xl border border-gray-200 bg-white p-8 shadow-sm dark:border-gray-800 dark:bg-gray-950">
        <div class="space-y-8">
          
          <div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
              Accessibility First
            </h3>

            <p class="mt-2 text-gray-600 dark:text-gray-400">
              Content designed for easy understanding using visual and simple explanations.
            </p>
          </div>

          <div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
              Community Empowerment
            </h3>

            <p class="mt-2 text-gray-600 dark:text-gray-400">
              Helping Deaf learners build confidence and career opportunities in technology.
            </p>
          </div>

          <div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
              Modern Technology
            </h3>

            <p class="mt-2 text-gray-600 dark:text-gray-400">
              Tutorials focused on real-world skills like HTML, CSS, JavaScript,
              React, Astro, AI tools, and accessibility.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Vision Section -->
  <section class="bg-white dark:bg-gray-950">
    <div class="mx-auto max-w-5xl px-4 py-20 text-center lg:px-8">
      
      <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-gray-500">
        Our Vision
      </p>

      <h2 class="text-4xl font-bold text-gray-900 dark:text-white">
        Building an Inclusive Tech Future
      </h2>

      <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-gray-600 dark:text-gray-400">
        We envision a future where Deaf individuals have equal access to
        technology education, career opportunities, and digital innovation.
        The Deaf Dev aims to become a trusted platform for accessible learning
        and community growth.
      </p>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="border-y border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-900">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 py-20 text-center sm:grid-cols-2 lg:grid-cols-4 lg:px-8">
      
      <div class="rounded-3xl border border-gray-200 bg-white p-8 dark:border-gray-800 dark:bg-gray-950">
        <h3 class="text-4xl font-bold text-gray-900 dark:text-white">
          100+
        </h3>

        <p class="mt-3 text-gray-600 dark:text-gray-400">
          Tutorials Planned
        </p>
      </div>

      <div class="rounded-3xl border border-gray-200 bg-white p-8 dark:border-gray-800 dark:bg-gray-950">
        <h3 class="text-4xl font-bold text-gray-900 dark:text-white">
          AI
        </h3>

        <p class="mt-3 text-gray-600 dark:text-gray-400">
          Accessibility Focus
        </p>
      </div>

      <div class="rounded-3xl border border-gray-200 bg-white p-8 dark:border-gray-800 dark:bg-gray-950">
        <h3 class="text-4xl font-bold text-gray-900 dark:text-white">
          Deaf
        </h3>

        <p class="mt-3 text-gray-600 dark:text-gray-400">
          Community Driven
        </p>
      </div>

      <div class="rounded-3xl border border-gray-200 bg-white p-8 dark:border-gray-800 dark:bg-gray-950">
        <h3 class="text-4xl font-bold text-gray-900 dark:text-white">
          Open
        </h3>

        <p class="mt-3 text-gray-600 dark:text-gray-400">
          Learning Platform
        </p>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-black text-white dark:bg-white dark:text-black">
    <div class="mx-auto max-w-5xl px-4 py-20 text-center lg:px-8">
      
      <h2 class="text-4xl font-bold">
        Start Your Learning Journey
      </h2>

      <p class="mx-auto mt-6 max-w-2xl text-lg opacity-80">
        Explore tutorials, courses, and resources designed for accessible learning.
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        
        <a
          href="/tutorials"
          class="rounded-2xl bg-white px-6 py-3 font-semibold text-black transition hover:opacity-90 dark:bg-black dark:text-white"
        >
          Explore Tutorials
        </a>

        <a
          href="/courses"
          class="rounded-2xl border border-white px-6 py-3 font-semibold transition hover:bg-white hover:text-black dark:border-black dark:hover:bg-black dark:hover:text-white"
        >
          View Courses
        </a>
      </div>
    </div>
  </section>
</Layout>