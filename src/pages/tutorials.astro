---
import Layout from "../layouts/MainLayout.astro";

const tutorials = [
  {
    title: "HTML",
    description:
      "Learn the foundation of web development using simple and beginner-friendly HTML tutorials.",
    icon: "🌐",
    link: "/tutorials/html",
    lessons: "25 Lessons",
  },

  {
    title: "CSS",
    description:
      "Create beautiful responsive layouts using modern CSS and Tailwind CSS.",
    icon: "🎨",
    link: "/tutorials/css",
    lessons: "30 Lessons",
  },

  {
    title: "JavaScript",
    description:
      "Learn JavaScript fundamentals, DOM manipulation, and interactive web development.",
    icon: "⚡",
    link: "/tutorials/javascript",
    lessons: "40 Lessons",
  },

  {
    title: "React",
    description:
      "Build reusable UI components and modern applications with React.",
    icon: "⚛️",
    link: "/tutorials/react",
    lessons: "35 Lessons",
  },

  {
    title: "Astro",
    description:
      "Learn Astro framework for building fast and content-focused websites.",
    icon: "🚀",
    link: "/tutorials/astro",
    lessons: "20 Lessons",
  },

  {
    title: "Git & GitHub",
    description:
      "Understand version control, repositories, commits, and collaboration workflows.",
    icon: "🐙",
    link: "/tutorials/github",
    lessons: "18 Lessons",
  },
];
---

<Layout
  title="Tutorials | The Deaf Dev"
  description="Explore coding tutorials, programming lessons, and web development learning paths."
>
  <!-- Hero -->
  <section class="border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-950">
    <div class="mx-auto max-w-5xl px-4 py-20 text-center lg:px-8">
      
      <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-gray-500">
        Tutorials
      </p>

      <h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white md:text-6xl">
        Learn Modern Web Development
      </h1>

      <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-gray-600 dark:text-gray-400">
        Explore beginner-friendly tutorials designed for accessible and visual learning.
        Learn coding step-by-step with practical examples and modern technologies.
      </p>
    </div>
  </section>

  <!-- Tutorials Grid -->
  <section class="bg-gray-50 dark:bg-gray-900">
    <div class="mx-auto max-w-7xl px-4 py-20 lg:px-8">
      
      <div class="mb-14 flex flex-col items-center justify-between gap-6 md:flex-row">
        
        <div>
          <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-gray-500">
            Learning Paths
          </p>

          <h2 class="text-4xl font-bold text-gray-900 dark:text-white">
            Featured Tutorials
          </h2>
        </div>

        <!-- Search -->
        <div class="w-full md:w-80">
          <input
            type="text"
            placeholder="Search tutorials..."
            class="w-full rounded-2xl border border-gray-300 bg-white px-5 py-3 outline-none transition focus:border-black dark:border-gray-700 dark:bg-gray-950 dark:text-white dark:focus:border-white"
          />
        </div>
      </div>

      <!-- Cards -->
      <div class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">
        
        {tutorials.map((tutorial) => (
          <a
            href={tutorial.link}
            class="group rounded-3xl border border-gray-200 bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:shadow-lg dark:border-gray-800 dark:bg-gray-950"
          >
            <!-- Icon -->
            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-black text-3xl text-white dark:bg-white dark:text-black">
              {tutorial.icon}
            </div>

            <!-- Title -->
            <h3 class="mt-6 text-2xl font-bold text-gray-900 dark:text-white">
              {tutorial.title}
            </h3>

            <!-- Lessons -->
            <p class="mt-2 text-sm font-medium text-gray-500">
              {tutorial.lessons}
            </p>

            <!-- Description -->
            <p class="mt-5 leading-7 text-gray-600 dark:text-gray-400">
              {tutorial.description}
            </p>

            <!-- Button -->
            <div class="mt-8 inline-flex items-center font-semibold text-black transition group-hover:translate-x-1 dark:text-white">
              Start Learning →
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Learning Style -->
  <section class="bg-white dark:bg-gray-950">
    <div class="mx-auto max-w-7xl px-4 py-20 lg:px-8">
      
      <div class="grid items-center gap-16 lg:grid-cols-2">
        
        <!-- Left -->
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-gray-500">
            Learning Experience
          </p>

          <h2 class="text-4xl font-bold text-gray-900 dark:text-white">
            Built for Accessible Education
          </h2>

          <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-400">
            Tutorials are structured with simple explanations, visual examples,
            and practical exercises to make learning easier for everyone.
          </p>
        </div>

        <!-- Right -->
        <div class="grid gap-6 sm:grid-cols-2">
          
          <div class="rounded-3xl border border-gray-200 p-8 dark:border-gray-800">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
              Step-by-Step
            </h3>

            <p class="mt-3 text-gray-600 dark:text-gray-400">
              Learn coding concepts gradually with beginner-friendly lessons.
            </p>
          </div>

          <div class="rounded-3xl border border-gray-200 p-8 dark:border-gray-800">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
              Visual Examples
            </h3>

            <p class="mt-3 text-gray-600 dark:text-gray-400">
              Clear examples and structured layouts for easy understanding.
            </p>
          </div>

          <div class="rounded-3xl border border-gray-200 p-8 dark:border-gray-800">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
              Modern Technology
            </h3>

            <p class="mt-3 text-gray-600 dark:text-gray-400">
              Learn modern tools like Astro, Tailwind CSS, React, and GitHub.
            </p>
          </div>

          <div class="rounded-3xl border border-gray-200 p-8 dark:border-gray-800">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
              Community Support
            </h3>

            <p class="mt-3 text-gray-600 dark:text-gray-400">
              Empowering learners through accessible technology education.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-black text-white dark:bg-white dark:text-black">
    <div class="mx-auto max-w-5xl px-4 py-20 text-center lg:px-8">
      
      <h2 class="text-4xl font-bold">
        Start Learning Today
      </h2>

      <p class="mx-auto mt-6 max-w-2xl text-lg opacity-80">
        Build coding skills through accessible tutorials and practical learning paths.
      </p>

      <div class="mt-10">
        <a
          href="/resources"
          class="rounded-2xl bg-white px-7 py-4 font-semibold text-black transition hover:opacity-90 dark:bg-black dark:text-white"
        >
          Explore Resources
        </a>
      </div>
    </div>
  </section>
</Layout>