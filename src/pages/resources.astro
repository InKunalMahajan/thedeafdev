---
import Layout from "../layouts/MainLayout.astro";
---

<Layout
  title="Resources | The Deaf Dev"
  description="Explore coding resources, tools, guides, and learning materials for accessible technology education."
>
  <!-- Hero Section -->
  <section class="border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-950">
    <div class="mx-auto max-w-5xl px-4 py-20 text-center lg:px-8">
      
      <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-gray-500">
        Learning Resources
      </p>

      <h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white md:text-6xl">
        Tools & Resources for Developers
      </h1>

      <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-gray-600 dark:text-gray-400">
        Explore useful coding resources, development tools, learning materials,
        accessibility guides, and educational content designed for modern learners.
      </p>
    </div>
  </section>

  <!-- Featured Resources -->
  <section class="bg-gray-50 dark:bg-gray-900">
    <div class="mx-auto max-w-7xl px-4 py-20 lg:px-8">
      
      <div class="mb-14 text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-gray-500">
          Featured Resources
        </p>

        <h2 class="text-4xl font-bold text-gray-900 dark:text-white">
          Popular Learning Materials
        </h2>
      </div>

      <div class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">
        
        <!-- Resource Card -->
        <div class="rounded-3xl border border-gray-200 bg-white p-8 shadow-sm transition hover:-translate-y-1 dark:border-gray-800 dark:bg-gray-950">
          <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-black text-2xl text-white dark:bg-white dark:text-black">
            🌐
          </div>

          <h3 class="text-2xl font-bold text-gray-900 dark:text-white">
            HTML Guide
          </h3>

          <p class="mt-4 leading-7 text-gray-600 dark:text-gray-400">
            Beginner-friendly HTML tutorials and structure examples for web development.
          </p>

          <a
            href="/tutorials/html"
            class="mt-6 inline-flex items-center font-semibold text-black dark:text-white"
          >
            Learn More →
          </a>
        </div>

        <!-- Resource Card -->
        <div class="rounded-3xl border border-gray-200 bg-white p-8 shadow-sm transition hover:-translate-y-1 dark:border-gray-800 dark:bg-gray-950">
          <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-black text-2xl text-white dark:bg-white dark:text-black">
            🎨
          </div>

          <h3 class="text-2xl font-bold text-gray-900 dark:text-white">
            CSS Resources
          </h3>

          <p class="mt-4 leading-7 text-gray-600 dark:text-gray-400">
            Modern layouts, responsive design, Flexbox, Grid, and Tailwind CSS resources.
          </p>

          <a
            href="/tutorials/css"
            class="mt-6 inline-flex items-center font-semibold text-black dark:text-white"
          >
            Learn More →
          </a>
        </div>

        <!-- Resource Card -->
        <div class="rounded-3xl border border-gray-200 bg-white p-8 shadow-sm transition hover:-translate-y-1 dark:border-gray-800 dark:bg-gray-950">
          <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-black text-2xl text-white dark:bg-white dark:text-black">
            ⚡
          </div>

          <h3 class="text-2xl font-bold text-gray-900 dark:text-white">
            JavaScript
          </h3>

          <p class="mt-4 leading-7 text-gray-600 dark:text-gray-400">
            Learn JavaScript fundamentals, DOM manipulation, and interactive web development.
          </p>

          <a
            href="/tutorials/javascript"
            class="mt-6 inline-flex items-center font-semibold text-black dark:text-white"
          >
            Learn More →
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- Tools Section -->
  <section class="bg-white dark:bg-gray-950">
    <div class="mx-auto max-w-7xl px-4 py-20 lg:px-8">
      
      <div class="mb-14 text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-gray-500">
          Developer Tools
        </p>

        <h2 class="text-4xl font-bold text-gray-900 dark:text-white">
          Recommended Tools
        </h2>
      </div>

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
        
        <!-- Tool -->
        <div class="rounded-3xl border border-gray-200 p-8 text-center dark:border-gray-800">
          <div class="text-5xl">💻</div>

          <h3 class="mt-5 text-xl font-semibold text-gray-900 dark:text-white">
            VS Code
          </h3>

          <p class="mt-3 text-gray-600 dark:text-gray-400">
            Powerful code editor for web development and programming.
          </p>
        </div>

        <!-- Tool -->
        <div class="rounded-3xl border border-gray-200 p-8 text-center dark:border-gray-800">
          <div class="text-5xl">🚀</div>

          <h3 class="mt-5 text-xl font-semibold text-gray-900 dark:text-white">
            Astro
          </h3>

          <p class="mt-3 text-gray-600 dark:text-gray-400">
            Fast modern framework for building content-focused websites.
          </p>
        </div>

        <!-- Tool -->
        <div class="rounded-3xl border border-gray-200 p-8 text-center dark:border-gray-800">
          <div class="text-5xl">🎯</div>

          <h3 class="mt-5 text-xl font-semibold text-gray-900 dark:text-white">
            Tailwind CSS
          </h3>

          <p class="mt-3 text-gray-600 dark:text-gray-400">
            Utility-first CSS framework for modern responsive UI design.
          </p>
        </div>

        <!-- Tool -->
        <div class="rounded-3xl border border-gray-200 p-8 text-center dark:border-gray-800">
          <div class="text-5xl">🌍</div>

          <h3 class="mt-5 text-xl font-semibold text-gray-900 dark:text-white">
            GitHub
          </h3>

          <p class="mt-3 text-gray-600 dark:text-gray-400">
            Version control and collaboration platform for developers.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Accessibility Section -->
  <section class="border-y border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-900">
    <div class="mx-auto max-w-5xl px-4 py-20 text-center lg:px-8">
      
      <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-gray-500">
        Accessibility
      </p>

      <h2 class="text-4xl font-bold text-gray-900 dark:text-white">
        Inclusive Learning Matters
      </h2>

      <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-gray-600 dark:text-gray-400">
        The Deaf Dev focuses on accessible and visual-first education.
        We aim to make technology learning easier for Deaf learners through
        clear structure, simple explanations, and practical examples.
      </p>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-black text-white dark:bg-white dark:text-black">
    <div class="mx-auto max-w-5xl px-4 py-20 text-center lg:px-8">
      
      <h2 class="text-4xl font-bold">
        Continue Your Learning Journey
      </h2>

      <p class="mx-auto mt-6 max-w-2xl text-lg opacity-80">
        Explore tutorials, tools, and courses built for accessible technology education.
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        
        <a
          href="/tutorials"
          class="rounded-2xl bg-white px-6 py-3 font-semibold text-black transition hover:opacity-90 dark:bg-black dark:text-white"
        >
          Browse Tutorials
        </a>

        <a
          href="/courses"
          class="rounded-2xl border border-white px-6 py-3 font-semibold transition hover:bg-white hover:text-black dark:border-black dark:hover:bg-black dark:hover:text-white"
        >
          Explore Courses
        </a>
      </div>
    </div>
  </section>
</Layout>